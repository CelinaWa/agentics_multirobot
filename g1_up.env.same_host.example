# Settings for rax/scripts/g1_up.sh when SONIC and RAX run on the SAME machine. Copy to ~/.g1_up.env.
# --- RAX host (this machine) --------------------------------------------------------------------
RAX_PYTHON=$HOME/envs/rax-g1/bin/python           # robot service env (setup_rax_host.sh)
RAX_AGENT_PYTHON=$HOME/envs/rax-agent/bin/python   # the agent's env: no robot packages
OPTIONS_JSON=$HOME/g1_real_options.json            # from docs/g1_real_options.example.json; state_host = 127.0.0.1
RAX_HOST_IP=127.0.0.1                              # SONIC's --zmq-host: same machine, loopback
RAX_PROTECTED_PATHS=$HOME/envs/rax-g1:$HOME/GR00T-WholeBodyControl   # the agent's sandbox may not read these
# --- G1's Jetson (stock head RealSense) ---------------------------------------------------------
ROBOT_IP=192.168.123.164
JETSON_SSH=unitree@192.168.123.164
JETSON_CAMERA_CMD='cd ~/jetson_camera && python3 camera_server.py --camera realsense --port 7790'
# For a ZED plugged into THIS machine instead: JETSON_SSH= (empty) and
# JETSON_CAMERA_CMD='cd ~/agentics_multirobot/jetson_camera && python3 camera_server.py --camera zedsdk --port 7790'
# plus camera_host 127.0.0.1 and a measured camera_pose_override in g1_real_options.json.
# --- SONIC (this machine) -----------------------------------------------------------------------
SONIC_SSH=                                         # EMPTY = SONIC runs here
SONIC_DEPLOY_DIR=$HOME/GR00T-WholeBodyControl/gear_sonic_deploy
SONIC_REF_DIR=reference/standing/                  # copied from sonic/reference_standing/ in this repo
SONIC_PLANNER=planner/target_vel/V2/planner_sonic.onnx
