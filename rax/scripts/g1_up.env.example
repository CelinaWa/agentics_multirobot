# Settings for scripts/g1_up.sh (copy to ~/.g1_up.env and fill in). Plain bash variables.

# --- RAX host (this machine) ---------------------------------------------------------------
RAX_PYTHON=$HOME/envs/rax-g1/bin/python          # robot service env: zmq, numpy, opencv (no Unitree SDK needed)
RAX_AGENT_PYTHON=$HOME/envs/rax-agent/bin/python  # the agent's env: no robot packages at all
OPTIONS_JSON=$HOME/g1_real_options.json           # copy of 3/g1_real_options.example.json with the IPs filled in
RAX_HOST_IP=192.168.123.50                        # this machine on the robot network: SONIC's --zmq-host points here
RAX_PROTECTED_PATHS=$HOME/envs/rax-g1             # paths the agent's sandbox must not read (colon separated)

# --- G1's Jetson (head camera) --------------------------------------------------------------
ROBOT_IP=192.168.123.164
JETSON_SSH=unitree@192.168.123.164
JETSON_CAMERA_CMD='cd ~/jetson_bundle && python3 camera_server.py --camera realsense --port 7790'

# --- SONIC host ---------------------------------------------------------------------------------
SONIC_SSH=                                        # user@host; EMPTY = SONIC runs on this machine
SONIC_DEPLOY_DIR=$HOME/GR00T-WholeBodyControl/gear_sonic_deploy
SONIC_REF_DIR=reference/standing/                 # the standing-only reference (3/eng/make_standing_ref.py)
SONIC_PLANNER=planner/target_vel/V2/planner_sonic.onnx
